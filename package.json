{
  "name": "jansunwai-ai",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "install:all": "npm install --workspace=client && npm install --workspace=server"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
